# Document Analyzer & Search Engine - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME="Document Analyzer & Search Engine"
DEBUG=True

# =============================================================================
# AWS S3 Configuration (Optional)
# Leave empty or set USE_S3_STORAGE=False for local-only storage
# =============================================================================
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# =============================================================================
# OCR Configuration
# =============================================================================
# Path to tesseract executable (if not in system PATH)
# Mac (Homebrew): /opt/homebrew/bin/tesseract
# Linux: /usr/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OCR language (default: eng)
# Multiple languages: eng+fra+deu
OCR_LANGUAGE=eng

# =============================================================================
# Embedding Models
# =============================================================================
# Text embedding model from sentence-transformers
# Options: all-MiniLM-L6-v2, all-mpnet-base-v2, paraphrase-MiniLM-L6-v2
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Image embedding model
IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch32

# =============================================================================
# API Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Search Settings
# =============================================================================
DEFAULT_TOP_K=5
MAX_TOP_K=100
